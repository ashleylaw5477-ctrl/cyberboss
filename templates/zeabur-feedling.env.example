# Zeabur environment template for CyberBoss + the official Feedling resident consumer.
# Never commit real values. Set these in the Zeabur service Variables panel.

# CyberBoss lifecycle
CYBERBOSS_AUTOSTART=true
CYBERBOSS_RUNTIME=claudecode

# Feedling resident consumer (official feedling-mcp/tools/chat_resident_consumer.py)
FEEDLING_RESIDENT_ENABLED=true
FEEDLING_API_URL=https://api.feedling.app
FEEDLING_API_KEY=
FEEDLING_ENCLAVE_URL=

# Consumer uses the SAME runtime/profile as CyberBoss. Leave the command blank
# unless the Zeabur image exposes a non-standard executable.
CYBERBOSS_CLAUDE_COMMAND=claude
CLAUDE_CONFIG_DIR=/data/home/.claude
FEEDLING_AGENT_CLI_CMD=

# Official consumer checkout is cloned from feedling-mcp/main at image build.
# These are optional runtime overrides; do not point them at an untrusted fork.
FEEDLING_CONSUMER_DIR=/opt/feedling-mcp
FEEDLING_CONSUMER_PYTHON=/opt/feedling-venv/bin/python
FEEDLING_AUTO_UPDATE=1

# Keep the official decrypt and proactive paths enabled.
FEEDLING_GENESIS_RESIDENT_ENABLED=1
PROACTIVE_POLL_ENABLED=true
PROACTIVE_TICK_ENABLED=true
PROACTIVE_SCHEDULED_FIRE_ENABLED=true

# Official consumer operational defaults.
POLL_TIMEOUT=30
SEND_FALLBACK_ON_AGENT_ERROR=false
LOG_LEVEL=INFO
